# Port the Express scan server listens on.
PORT=4000

# Origin allowed to call this API — your Vite dev server by default.
# Only matters if the frontend is running as a separate service from
# this backend (see root DEPLOY.md); same-origin requests don't need it.
CORS_ORIGIN=http://localhost:5173

# Get a free key at https://aistudio.google.com/app/apikey
# Powers the "Explain the fix" feature. This key stays server-side —
# never prefix it with VITE_, or it'll get bundled into the frontend
# and exposed to anyone visiting the site.
GEMINI_API_KEY=your_gemini_api_key_here
