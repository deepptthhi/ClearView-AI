# The Gemini key lives in backend/.env now, not here — the "Explain the
# fix" feature calls our own backend, which proxies the Gemini request
# server-side. Nothing frontend-side needs an API key.

# Only set this if the backend runs as a SEPARATE service/URL from the
# frontend (e.g. running each with its own `npm run dev`, or deploying
# them to two different hosts). Leave it unset/blank if the backend
# serves the built frontend itself (see root README) — relative paths
# will just work.
# VITE_API_BASE_URL=http://localhost:4000
